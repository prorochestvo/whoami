{{- define "layout" -}}
<!doctype html>
<html lang="{{ .Lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }}</title>
  <meta name="description" content="{{ .Description }}">
  <link rel="canonical" href="{{ .CanonicalURL }}">

  {{- range .Alternates }}
  <link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Href }}">
  {{- end }}

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ .Title }}">
  <meta property="og:description" content="{{ .Description }}">
  <meta property="og:url" content="{{ .CanonicalURL }}">
  <meta property="og:image" content="{{ .OGImage }}">
  <meta property="og:image:alt" content="{{ .OGImageAlt }}">
  <meta property="og:image:width" content="{{ .OGImageWidth }}">
  <meta property="og:image:height" content="{{ .OGImageHeight }}">
  <meta property="og:site_name" content="{{ .Resume.Person.Name }}">
  {{- with .OGLocale }}
  <meta property="og:locale" content="{{ . }}">
  {{- end }}
  {{- range .OGLocaleAlternates }}
  <meta property="og:locale:alternate" content="{{ . }}">
  {{- end }}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ .Title }}">
  <meta name="twitter:description" content="{{ .Description }}">
  <meta name="twitter:image" content="{{ .OGImage }}">

  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0b0e14">

  <link rel="icon" href="/img/favicon-32.png?v={{ .GeneratedAt.Unix }}" sizes="32x32" type="image/png">
  <link rel="icon" href="/img/favicon-16.png?v={{ .GeneratedAt.Unix }}" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png?v={{ .GeneratedAt.Unix }}">
  <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css?v={{ .GeneratedAt.Unix }}">
  {{- with .PersonLD }}
  {{ . }}
  {{- end }}
</head>
<body>
  <div class="progress-bar" role="progressbar" aria-label="Loading" aria-hidden="true"></div>
  {{ template "content" . }}
  <script src="/js/main.js?v={{ .GeneratedAt.Unix }}" defer></script>
  <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "4c14821d6d6c40b9b7ff535b2c916441"}'></script>
</body>
</html>
{{- end -}}
